# `* text=auto` first: it stops core.autocrlf from rewriting files that have
# an explicit rule below, which otherwise leaves the working tree dirty after
# every checkout on Windows.
* text=auto

# .bat MUST stay CRLF: cmd.exe mis-parses a Unix-line-ending batch file and
# runs fragments of Chinese lines as commands ("'?OKX' is not recognized").
*.bat text eol=crlf

# Everything else is normalised to LF in the repo.
*.py   text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Frontend sources: LF in the working tree too. Without an explicit rule they
# fall back to core.autocrlf (=true on Windows), so git keeps rewriting them
# to CRLF and `git status` shows phantom modifications after every checkout.
*.vue  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
