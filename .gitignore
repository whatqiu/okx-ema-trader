# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Runtime output — regenerated, never a source of truth
logs/
data/
state.yaml
*.log

# Frontend — node_modules is tens of thousands of files and must never be
# committed. dist/ IS tracked on purpose: it is ~110 KB of built assets and
# keeping it in the repo means a fresh clone can start the platform without
# running npm at all (start-platform.bat serves it directly).
platform/frontend/node_modules/
platform/frontend/.vite/

# Local / machine-specific
.claude/
.mcp.json
.workbuddy/
.cleanup-backup/
config/console.json

# Secrets live in ~/.okx/config.toml, never in this repo.
# If you ever add one here, it is already ignored:
.env
*.key
*.pem
credentials.toml

# OS
.DS_Store
Thumbs.db
